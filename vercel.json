{
  "rewrites": [
    { "source": "/admin/assets/:file", "destination": "/assets/:file" },
    { "source": "/admin/favicon.png", "destination": "/favicon.png" },
    { "source": "/admin/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
